# =============================================================================
# Luckygames — arquivo de exemplo / documentação das variáveis de ambiente.
#
# Este arquivo é VERSIONADO: nunca coloque segredos reais aqui. Os campos
# marcados como SECRET devem ficar só no .env local (ignorado pelo git) ou nos
# secrets do Coolify. A ordem e as chaves abaixo espelham o ambiente de produção.
# =============================================================================

# Nota: a versão do Node vem fixada no Dockerfile (node:22-alpine). A antiga
# variável NIXPACKS_NODE_VERSION não é lida por nenhum código e foi removida.

# --- Banco de dados PostgreSQL -----------------------------------------------
# Host do Postgres. No Coolify é o nome do serviço/container (ex.: postgresql);
# em desenvolvimento local costuma ser localhost.
POSTGRES_HOST=postgresql
# Porta do Postgres.
POSTGRES_PORT=5432
# Usuário do banco.
POSTGRES_USER=luckygames
# SECRET — senha do banco. Deixe em branco aqui; defina no .env local / Coolify.
POSTGRES_PASSWORD=
# Nome do banco de dados.
POSTGRES_DATABASE=luckygames
# Usa TLS na conexão com o Postgres (true/false).
POSTGRES_SSL=false
# Permite TLS sem validar o certificado (só use com POSTGRES_SSL=true e certificado self-signed).
POSTGRES_SSL_ALLOW_INSECURE=false
# Timeout (ms) para estabelecer a conexão.
POSTGRES_CONNECTION_TIMEOUT_MS=5000
# Timeout (ms) para conexões ociosas no pool antes de serem fechadas.
POSTGRES_IDLE_TIMEOUT_MS=30000
# Timeout (ms) máximo por query.
POSTGRES_QUERY_TIMEOUT_MS=30000
# Timeout (ms) do statement no servidor Postgres.
POSTGRES_STATEMENT_TIMEOUT_MS=30000
# Número máximo de conexões simultâneas no pool.
POSTGRES_POOL_MAX=10
# Máximo de usos por conexão antes de reciclá-la. Em branco = sem limite.
POSTGRES_POOL_MAX_USES=

# --- Runtime / rede ----------------------------------------------------------
# Opcional: string de conexão do Cloudflare Hyperdrive (só no caminho Cloudflare Workers).
# Deixe em branco no deploy Node/Coolify.
HYPERDRIVE_CONNECTION_STRING=
# Opcional: defina como "cloudflare" apenas no runtime Cloudflare Workers.
# Em branco no deploy Node (o dotenv carrega o .env normalmente).
NEXT_RUNTIME_PROVIDER=
# Opcional: presente automaticamente no runtime Cloudflare Workers; também sinaliza
# esse ambiente (força pool de 1 conexão). Deixe em branco no deploy Node/Coolify.
# CF_WORKER_NAME=
# Domínio oficial do site; usado para montar URLs absolutas (magic link, back_urls, webhook).
OFFICIAL_DOMAIN_NAME=luckygames.tips
# SECRET — protege o endpoint GET de sincronização de resultados usado por schedulers externos.
# Gere um valor aleatório longo e mantenha fora do git.
SYNC_CRON_SECRET=
# Versão exibida na interface (público — prefixo NEXT_PUBLIC).
NEXT_PUBLIC_APP_VERSION=v2.0.0

# --- Passe pago: cookie de acesso --------------------------------------------
# SECRET — chave HMAC que assina o cookie de acesso e o cookie de quota do chat.
# Mínimo de 32 caracteres; abaixo disso o app trata como ausente (acesso pago desligado).
ACCESS_COOKIE_SECRET=

# --- Passe pago: envio do magic link por e-mail (SMTP) -----------------------
# Host do servidor SMTP.
SMTP_HOST=smtp.forwardemail.net
# Porta SMTP (587 para STARTTLS, 465 para TLS implícito).
SMTP_PORT=587
# true para TLS implícito (porta 465); false para STARTTLS (porta 587).
SMTP_SECURE=false
# Usuário/login SMTP.
SMTP_USER=luckygames@luckygames.tips
# SECRET — senha SMTP. Deixe em branco aqui.
SMTP_PASSWORD=
# Remetente dos e-mails. O nome de exibição NÃO deve conter ponto sem aspas
# (ex.: "Luckygames.tips" quebra o header RFC 5322 ao perder as aspas no deploy);
# por isso usamos um nome simples sem ponto.
SMTP_FROM=Luckygames <luckygames@luckygames.tips>

# --- Passe pago: Mercado Pago ------------------------------------------------
# SECRET — Access Token do Mercado Pago (TEST-... em sandbox, APP_USR-... em produção).
# Sem ele o checkout responde 503 (pagamento desligado).
MP_ACCESS_TOKEN=
# Public Key do Mercado Pago. Só é usada em Checkout Bricks/Transparente;
# o Checkout Pro atual não precisa dela. Opcional.
MP_PUBLIC_KEY=
# SECRET — assinatura do webhook, gerada no painel (Suas integrações > Webhooks).
# Sem ela, TODO webhook é rejeitado (fail-closed) e nenhuma licença é ativada.
MP_WEBHOOK_SECRET=
# Opcional: sobrescreve a base da API do Mercado Pago (útil só em testes).
# Padrão quando em branco: https://api.mercadopago.com
# MP_API_BASE_URL=
# Preço do passe de 30 dias, em reais. Aceita vírgula ou ponto. Faixa válida: 1 a 10000.
# Fora da faixa ou inválido, cai no padrão 10.
PASS_PRICE_30D_BRL=10
# Preço do passe vitalício, em reais. Mesma validação. Padrão quando inválido: 50.
PASS_PRICE_LIFETIME_BRL=50

# --- Analytics (Umami) — público (prefixo NEXT_PUBLIC) -----------------------
# URL do script do Umami. Em branco desativa o analytics.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.cabral.dev/script.js
# ID do site no Umami.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=ea4bd301-7337-44bd-9ec9-746074f3f4de

# --- Comentários (Remark42) — público (prefixo NEXT_PUBLIC) ------------------
# Host do servidor Remark42.
NEXT_PUBLIC_REMARK42_HOST=https://comments.cabral.dev
# ID do site configurado no Remark42.
NEXT_PUBLIC_REMARK42_SITE_ID=global
# Locale da interface de comentários (bp = português do Brasil).
NEXT_PUBLIC_REMARK42_LOCALE=bp
# Oculta o rodapé "powered by" do Remark42.
NEXT_PUBLIC_REMARK42_NO_FOOTER=true

# --- Chat GPT (assistente opcional) ------------------------------------------
# SECRET — chave da API da OpenAI. O chat só liga quando API key E modelo estão definidos.
OPENAI_API_KEY=
# Modelo de chat da OpenAI (ex.: gpt-5.4-nano).
OPENAI_CHAT_MODEL=gpt-5.4-nano
# Limite de caracteres da resposta do chat. Faixa aceita: 400 a 6000 (fora disso é ajustado).
OPENAI_CHAT_MAX_REPLY_CHARS=4000
# Opcional: teto de tokens de conclusão. Em branco usa o padrão ciente do modelo. Faixa: 120 a 32000.
OPENAI_CHAT_COMPLETION_TOKENS=
# Opcional: teto de tokens numa nova tentativa após resposta truncada. Mesma faixa.
OPENAI_CHAT_RETRY_COMPLETION_TOKENS=

# Botões de sugestão do chat. Formato por botão: Rótulo|Pergunta curta|Instrução detalhada para o modelo.
CHATGPT_BUTTON1=Mapa quente|Identifique números pelo mapa quente.|Use o mapa de calor/frequência do recorte para identificar números candidatos. Responda direto em tópicos: Quentes, Apoio, Fracos/evitar e Combinação sugerida compatível com a loteria. Foque em números e chance relativa no recorte, sem introdução, conclusão ou alertas.
CHATGPT_BUTTON2=Surpresas|Aponte números surpresa.|Identifique números surpresa no recorte: pouco óbvios, frios retomando, atrasados com sinal recente ou faixas fora do padrão. Responda direto com números, motivo curto e uma combinação surpresa compatível com a loteria. Sem introdução, conclusão ou alertas.
CHATGPT_BUTTON3=Ciclos|Mostre números por ciclos e atrasos.|Analise ciclos, atrasos e recorrência para identificar números candidatos. Separe em Recorrentes, Atrasados úteis, Retomada recente e Combinação sugerida compatível com a loteria. Foque em números e critérios curtos, sem introdução, conclusão ou alertas.
CHATGPT_BUTTON4=Estratégia|Monte uma estratégia de números.|Monte uma estratégia objetiva de números combinando frequência, atraso, recência e distribuição por faixas. Entregue Base, Complementares, Ousadia e Combinação sugerida compatível com a loteria. Use critérios curtos e diretos, sem introdução, conclusão ou alertas.

# --- Porta da aplicação ------------------------------------------------------
# O container Docker (standalone) escuta na porta definida por PORT (padrão 3000 no Dockerfile).
# Em desenvolvimento local, o wrapper scripts/run-next.cjs usa APP_PORT (padrão 4000).
# PORT=3000
# APP_PORT=4000
