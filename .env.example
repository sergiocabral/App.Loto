APP_PORT=4000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=luckygames
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=luckygames
POSTGRES_SSL=false
POSTGRES_SSL_ALLOW_INSECURE=false

POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_QUERY_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_POOL_MAX=10
POSTGRES_POOL_MAX_USES=

# Optional: set when using Cloudflare Workers/Hyperdrive instead of POSTGRES_* connection fields.
HYPERDRIVE_CONNECTION_STRING=
NEXT_RUNTIME_PROVIDER=
OFFICIAL_DOMAIN_NAME=luckygames.tips

# Optional: protects the GET endpoint used by external schedulers to sync lottery results.
# Example only. Use a different private value in .env/local secrets/Cloudflare.
SYNC_CRON_SECRET=change-this-random-cron-secret

NEXT_PUBLIC_APP_VERSION=v2.0.0

NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.cabral.dev/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=ea4bd301-7337-44bd-9ec9-746074f3f4de

NEXT_PUBLIC_REMARK42_HOST=https://comments.cabral.dev
NEXT_PUBLIC_REMARK42_SITE_ID=global
NEXT_PUBLIC_REMARK42_LOCALE=bp
NEXT_PUBLIC_REMARK42_NO_FOOTER=true

# Optional: enables the server-side Chat GPT assistant only when both values are set. Keep the real key out of git.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# Optional: controls Chat GPT response size. Leave token fields blank to use model-aware defaults.
OPENAI_CHAT_MAX_REPLY_CHARS=4000
OPENAI_CHAT_COMPLETION_TOKENS=
OPENAI_CHAT_RETRY_COMPLETION_TOKENS=
CHATGPT_BUTTON1=Mapa quente|Identifique números pelo mapa quente.|Priorize as dezenas de maior frequência no recorte, usando a lista 'Mais sorteados'. Separe em Quentes (topo da frequência), Apoio (frequência média) e Evitar (frias do período), citando ao lado de cada dezena quantas vezes saiu. Feche com uma Combinação sugerida válida para a loteria atual, equilibrando pares e ímpares e as faixas baixa/média/alta.
CHATGPT_BUTTON2=Surpresas|Aponte números surpresa.|Aponte dezenas fora do óbvio no recorte: frias começando a voltar, atrasadas com aparição recente e faixas pouco exploradas. Liste cada candidata com um motivo de uma linha baseado nos dados enviados. Feche com uma Combinação surpresa válida para a loteria atual, misturando 1 ou 2 dezenas quentes com o restante de baixa probabilidade aparente.
CHATGPT_BUTTON3=Ciclos|Mostre números por ciclos e atrasos.|Cruze atraso e recência usando 'Mais atrasados' e 'Mais recentes'. Separe em Atrasados úteis (atraso alto já com sinal de retomada), Em ritmo (recorrência recente forte) e Neutros. Diga o atraso de cada dezena citada. Feche com uma Combinação sugerida válida para a loteria atual, priorizando atrasados prestes a retornar sem abrir mão de 1 ou 2 dezenas em ritmo.
CHATGPT_BUTTON4=Estratégia|Monte uma estratégia de números.|Monte uma estratégia combinando frequência, atraso, recência e distribuição por faixas do recorte. Entregue Base (dezenas mais consistentes), Complementares (equilíbrio de faixas e de pares/ímpares) e Ousadia (1 ou 2 apostas contra a tendência). Explique em uma linha o critério de cada bloco. Feche com a Combinação final válida para a loteria atual, ordenada de forma crescente.

# --- Passe pago (Mercado Pago Pix + magic link) ---
# Segredo HMAC do cookie de acesso assinado. Mínimo 32 caracteres. Nunca versionar o valor real.
ACCESS_COOKIE_SECRET=change-this-random-32-plus-char-secret
# Token do Mercado Pago (TEST-... em sandbox, APP_USR-... em produção). Secret.
MP_ACCESS_TOKEN=
# Segredo de assinatura do webhook, gerado no painel do Mercado Pago (Suas integrações > Webhooks). Secret.
MP_WEBHOOK_SECRET=
# Opcional: sobrescreve a base da API do Mercado Pago (útil só em testes). Padrão: https://api.mercadopago.com
MP_API_BASE_URL=
# Opcional: preços dos passes em reais. Padrões: 10 (30 dias) e 50 (vitalício).
PASS_PRICE_30D_BRL=10
PASS_PRICE_LIFETIME_BRL=50

# SMTP para envio do magic link de acesso. Secret (senha).
SMTP_HOST=smtp.forwardemail.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=luckygames@luckygames.tips
SMTP_PASSWORD=
SMTP_FROM="Luckygames.tips" <luckygames@luckygames.tips>
